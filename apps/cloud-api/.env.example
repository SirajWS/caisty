# Beispiel-Umgebung für Caisty Cloud API (Kopie nach `.env` im selben Ordner `apps/cloud-api/`)

PORT=3333
DATABASE_URL=postgres://caisty:devpassword@localhost:5432/caisty
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars!!

# Öffentliche URLs
PORTAL_BASE_URL=http://localhost:5173
NODE_ENV=development

# Stripe (Test) — Price IDs aus dem Stripe Dashboard (keine Price-IDs erfinden)
# STRIPE_PRICE_STARTER_MONTHLY_EUR=price_...
# STRIPE_PRICE_STARTER_YEARLY_EUR=price_...
# STRIPE_PRICE_PRO_MONTHLY_EUR=price_...
# STRIPE_PRICE_PRO_YEARLY_EUR=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY_EUR=
# STRIPE_PRICE_BUSINESS_YEARLY_EUR=
# STRIPE_TAX_RATE_EUR_VAT_19=txr_...   # optional; wird sonst automatisch angelegt/gesucht (19 % exkl.)

# Die API lädt immer `apps/cloud-api/.env` (Pfad relativ zum Package, nicht nur process.cwd).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lokal typisch:
# GOOGLE_REDIRECT_URI=http://localhost:3333/portal/auth/google/callback
# Production:
# GOOGLE_REDIRECT_URI=https://api.caisty.com/portal/auth/google/callback
