# Local overrides — copy to .env.local (gitignored, highest priority)
VITE_CLOUD_API_URL=http://localhost:3333
VITE_PORTAL_BASE_URL=http://localhost:5173

# POS release — set VITE_POS_WINDOWS_URL only; version is parsed from the filename.
# .env.development and .env.production are committed with the current release URL.
# VITE_POS_WINDOWS_URL=https://www.caisty.com/downloads/Caisty.PoS_0.3.3_x64-setup.exe
# VITE_POS_RELEASE_DATE=2026-07-08
# VITE_POS_RELEASE_NOTES_URL=
# VITE_POS_RELEASE_NOTES_SUMMARY=
# VITE_POS_INSTALLER_SIZE_BYTES=
# VITE_POS_INSTALLER_SHA256=
# VITE_POS_INSTALLER_PLATFORM=Windows x64
# VITE_POS_DESKTOP_PROTOCOL=caisty
# VITE_POS_WEB_URL=https://pos.caisty.com
# VITE_POS_WEB_ENABLED=false
# Local dev (Caisty Web app running via `npm run dev:web` in caisty_pos):
# VITE_POS_WEB_URL=http://localhost:5174/pos
# VITE_POS_WEB_ENABLED=true
# VITE_PORTAL_ENV=staging

# After changing any VITE_* variable, restart the dev server (`pnpm dev`).
