{
  "redirects": [
    {
      "source": "/downloads/Caisty.PoS_0.3.5_x64-setup.exe",
      "destination": "/caisty-pos",
      "statusCode": 307
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/portal", "destination": "/index.html" },
    { "source": "/portal/(.*)", "destination": "/index.html" },
    {
      "source": "/((?!portal|downloads).*)",
      "destination": "/index.html"
    }
  ]
}
